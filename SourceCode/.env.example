OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ENTITY_MODEL=gpt-5.4-nano
AI_PIPELINE_VERSION=pdf-openai-v2

NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

FIREBASE_PROJECT_ID=lichsuvietnam-d3c26
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json
AI_ADMIN_API_KEY=replace-with-a-long-random-secret
AI_ALLOW_UNAUTHENTICATED=false
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

AI_CHUNK_SIZE=1600
AI_CHUNK_OVERLAP=220
AI_MAX_PDF_SIZE_MB=200
AI_ENABLE_PDF_OCR=true
AI_OCR_LANGUAGES=vie+eng
AI_OCR_JOBS=2
AI_OCR_FALLBACK_DPI=220
AI_OCR_PAGE_TIMEOUT_SECONDS=180
AI_OCR_PROCESS_TIMEOUT_SECONDS=14400
AI_RETRIEVAL_TOP_K=8
AI_RETRIEVAL_CANDIDATE_K=24
AI_MIN_RELEVANCE_SCORE=0.35
AI_ENABLE_RERANK=true
AI_ENABLE_ENTITY_EXTRACTION=true
AI_ENTITY_BATCH_SIZE=6
# Kho nội dung lịch sử đã được Admin xuất bản. Khi để trống URL, backend dùng
# https://<FIREBASE_PROJECT_ID>.web.app/content/manifest.json. Trong môi trường
# phát triển monorepo, backend tự ưu tiên manifest cục bộ của Web Admin.
AI_PUBLISHED_CONTENT_ENABLED=true
AI_PUBLISHED_CONTENT_MANIFEST_PATH=
AI_PUBLISHED_CONTENT_MANIFEST_URL=
AI_PUBLISHED_CONTENT_CACHE_TTL_SECONDS=300
AI_INDEX_CHECKPOINT_PATH=.data/index-checkpoints.sqlite3
